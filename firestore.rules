rules_version = '2';

/* ============================================================
   IBIME — reglas de seguridad (Principios y NEPO)
   Cópialas completas en: Firebase → Firestore Database → Reglas.

   ANTES DE PUBLICAR cambia dos cosas:
   1. DOMINIO  → el dominio de correo de tu colegio
   2. ADMINS   → los correos que son administradores desde el inicio
                 (los mismos que pusiste en js/config.js)
   ============================================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function DOMINIO() { return 'ibime.edu.mx'; }

    function ADMINS() {
      return [
        'josue.jain@ibime.edu.mx'
      ];
    }

    function entro() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function correo() {
      return request.auth.token.email.lower();
    }

    /* Solo cuentas del colegio. Si quieres abrirlo a cualquier cuenta de
       Google, deja este return en true. */
    function delColegio() {
      return entro() && correo().split('@')[1] == DOMINIO();
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activo() {
      return delColegio() && perfil().activo != false;
    }

    function admin() {
      return delColegio() && (correo() in ADMINS() || perfil().rol == 'admin');
    }

    /* Acceso al módulo NEPO: administración, o quien tenga NEPO en su lista de módulos. */
    function nepo() {
      return activo() && (admin() || ('nepo' in perfil().get('modulos', [])));
    }

    /* ---------- personas con acceso ---------- */
    match /usuarios/{uid} {
      allow read: if request.auth.uid == uid || admin();

      // primer ingreso: cada quien crea su propio perfil, como colaborador
      allow create: if delColegio()
                    && request.auth.uid == uid
                    && request.resource.data.correo == correo()
                    && (request.resource.data.rol == 'colaborador'
                        || (request.resource.data.rol == 'admin' && correo() in ADMINS()))
                    && request.resource.data.activo == true
                    && request.resource.data.get('modulos', ['principios']) == ['principios'];

      // cada quien refresca su nombre, foto y último acceso; el rol no
      allow update: if admin()
                    || (request.auth.uid == uid
                        && (request.resource.data.rol == resource.data.rol
                            || correo() in ADMINS())
                        && request.resource.data.activo == resource.data.activo
                        && request.resource.data.correo == resource.data.correo
                        && request.resource.data.get('modulos', []) == resource.data.get('modulos', []));

      allow delete: if false;   // el historial de accesos no se borra
    }

    /* ---------- catálogo de alumnos ---------- */
    match /alumnos/{matricula} {
      allow read:  if activo();
      allow write: if admin();
    }

    match /meta/{doc} {
      allow read:  if delColegio();
      allow write: if admin();
    }

    /* ---------- principios y actividades ---------- */
    match /principios/{id} {
      allow read:  if activo();
      allow write: if admin();
    }

    match /actividades/{id} {
      allow read:   if activo();
      allow create, delete: if admin();
      // el contador de asistencias lo mueve cualquiera que pase lista
      allow update: if admin()
                    || (activo() && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['total']));
    }

    /* ---------- asistencias ---------- */
    match /asistencias/{id} {
      allow read: if activo();

      allow create: if activo()
                    && request.resource.data.registradoPorUid == request.auth.uid
                    && request.resource.data.matricula is string
                    && request.resource.data.actividadId is string
                    && id == request.resource.data.actividadId + '__' + request.resource.data.matricula;

      // un registro no se edita: o está o no está
      allow update: if false;

      // lo quita quien lo puso, o la administración
      allow delete: if admin()
                    || (activo() && resource.data.registradoPorUid == request.auth.uid);
    }

    /* ============================================================
       NEPO — capacitaciones para familias
       ============================================================ */
    match /nepo_clases/{id} {
      allow read:  if nepo();
      allow write: if admin();
    }

    match /nepo_familiares/{id} {
      allow read, create, update: if nepo();
      allow delete: if admin();
    }

    match /nepo_inscripciones/{id} {
      allow read, write: if nepo();
    }

    match /nepo_sesiones/{id} {
      allow read, create, update: if nepo();
      allow delete: if nepo();
    }

    /* Aquí sí se puede corregir una marca (presente ↔ falta). */
    match /nepo_asistencias/{id} {
      allow read: if nepo();
      allow create, update: if nepo()
                    && request.resource.data.registradoPorUid == request.auth.uid
                    && id == request.resource.data.sesionId + '__' + request.resource.data.familiarId;
      allow delete: if nepo();
    }

    /* Seguimiento: solo lo leen los docentes de esa clase y la administración. */
    match /nepo_notas/{id} {
      allow read:   if nepo() && (admin() || correo() in resource.data.docentes);
      allow create: if nepo()
                    && request.resource.data.autorCorreo == correo()
                    && correo() in request.resource.data.docentes;
      allow update, delete: if admin() || (nepo() && resource.data.autorCorreo == correo());
    }

    match /nepo_plantillas/{tipo} {
      allow read:  if nepo();
      allow write: if admin();
    }

    /* Bitácora de correos: se escribe una vez y no se modifica. */
    match /nepo_correos/{id} {
      allow read, create: if nepo();
      allow update, delete: if false;
    }

    /* Todo lo demás queda cerrado. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
